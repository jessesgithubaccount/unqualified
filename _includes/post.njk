---
layout: base.njk
---
<article class="post-page wrap">
  <a class="back-link" href="/#posts">&larr; All Posts</a>
  <span class="tag-pill tag-{{ category | lower }}">{{ category }}</span>
  <h1>{{ title }}</h1>
  <div class="post-meta"><span>{{ date | readableDate }}</span><span>&middot;</span><span>{{ readtime }}</span></div>
  {% if image %}<img class="post-hero-img" src="{{ image }}" alt="{{ title }}">{% endif %}
  <div class="post-body">
    {{ content | safe }}
  </div>
</article>
